# ==========================================================
#  Inkwell API — environment template
#  Copy this file to .env and fill in your real values.
#  (.env is gitignored — real keys must never be committed)
# ==========================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database (MongoDB) ----------
# Local MongoDB:  mongodb://127.0.0.1:27017/blogapp
# MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/blogapp
MONGO_URI=mongodb://127.0.0.1:27017/blogapp

# ---------- Security ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-change-this
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
CLIENT_URL=http://localhost:3000
